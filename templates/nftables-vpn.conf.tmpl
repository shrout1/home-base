# Managed by home-base install.sh — only rendered when provisioning a fresh
# OpenVPN server (no existing one detected). Loaded with `nft -f` as a set
# of additive statements, NOT a full-ruleset file -- no `flush ruleset` here
# on purpose. This must never destroy pre-existing rules on the box; it only
# adds a new table by this name (a no-op if one already exists) and the
# chains/rules below.
table __NFT_FAMILY__ __NFT_TABLE__ {
    set __NFT_SET__ {
        type ipv4_addr
        flags interval
    }

    chain input {
        type filter hook input priority filter; policy drop;
        iifname "lo" accept
        ct state established,related accept
        ct state invalid drop
        iifname "__WAN_IF__" __OPENVPN_PROTO__ dport __OPENVPN_PORT__ ip saddr @__NFT_SET__ accept
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
        ct state established,related accept
        ct state invalid drop
        iifname "tun0" oifname "__WAN_IF__" accept
    }

    chain output {
        type filter hook output priority filter; policy accept;
    }
}

table ip nat {
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        ip saddr __OPENVPN_SUBNET_CIDR__ oifname "__WAN_IF__" masquerade
    }
}
