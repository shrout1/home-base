# Managed by home-base install.sh — do not edit by hand, edit homebase.conf instead.
[Unit]
Description=home-base whitelist sync + status dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/home-base/webapp/app.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
